# This repository is public. Ignore anything that is built, local, secret or
# agent-generated. scripts/check-public.mjs also fails on any tracked file that
# isn't on its allowlist, so a forced `git add -f` is still caught in CI.

# Dependencies and build output
node_modules/
dist/
*.tsbuildinfo
.pnpm-store/
.pnpm-debug.log*
.npm/
.yarn/
.pnp.*

# Packed tarballs (npm pack)
*.tgz

# Tests and coverage
coverage/
.nyc_output/
.vitest/
test-results/

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej
*.swp
*~

